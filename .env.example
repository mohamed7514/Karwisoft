# Copy to .env.local (never commit real values). On Vercel, set the same names in Project Settings > Environment Variables.
OPENAI_API_KEY=
# Optional (default: gpt-4.1)
OPENAI_MODEL=
# Comma-separated extra origins allowed to call /api/chat (the site's own origin is always allowed)
CHAT_ALLOWED_ORIGINS=
# Optional, process-local ceiling on model calls per day
CHAT_DAILY_LIMIT=
NEXT_PUBLIC_SITE_URL=

# Optional hosted checkout links (e.g. Stripe Payment Links), one per website offer. Without them the order is sent by email.
NEXT_PUBLIC_PAY_ESSENTIEL=
NEXT_PUBLIC_PAY_CROISSANCE=
NEXT_PUBLIC_PAY_PREMIUM=

# Contact, order and chat requests are emailed through Resend (https://resend.com).
# RESEND_API_KEY: create one in Resend. CONTACT_TO: where you receive requests (comma-separated).
# CONTACT_FROM: a sender on a domain verified in Resend, e.g. "Karwisoft <no-reply@karwisoft.com>".
RESEND_API_KEY=
CONTACT_TO=Support@karwisoft.com
CONTACT_FROM=
